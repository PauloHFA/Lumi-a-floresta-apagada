level_title = "Ato 1 - Raízes"
music_track = "mystery"
intro_dialogue = Array[String](["NARRADOR: A floresta que antes brilhava mergulhou em uma escuridão repentina.", "Lumi: Minha luz mal alcança um passo... o que aconteceu?", "Vovó Coruja: Acorde, pequeno. A noite está longa demais.", "Lumi: Vovó, por que o Grande Carvalho está apagado?", "Vovó Coruja: Ele se partiu, e seus três fragmentos de luz se espalharam pela floresta.", "Lumi: Se eu encontrar os fragmentos, posso trazer a luz de volta?", "Vovó Coruja: Sim. Algumas sombras estão assustadas e talvez precisem de ajuda, não de combate.", "Lumi: Então vou encontrar os fragmentos e ajudar a floresta."])

